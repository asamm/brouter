# piste:type;0000000001 nordic
# piste:type;0000000002 skitour

# piste:difficulty;0000000003 novice
# piste:difficulty;0000000003 easy
# piste:difficulty;0000000003 intermediate
# piste:difficulty;0000000003 advanced
# piste:difficulty;0000000003 expert
# piste:difficulty;0000000003 freeride
# piste:difficulty;0000000003 extreme

# piste:grooming;0000000004 classic
# piste:grooming;0000000004 classic+skating
# piste:grooming;0000000004 skating
# piste:grooming;0000000004 skating+classic
# piste:grooming;0000000004 scooter
# piste:grooming;0000000004 backcountry

# piste:oneway;0000000005 yes
# piste:oneway;0000000005 no 

---context:global   # following code refers to global config

assign validForBikes = true
assign validForFoot = true
assign validForCars = false

assign turnInstructionMode = 2 # locus-style
assign turnInstructionCatchingRange = 10

# the elevation parameters

assign downhillcost = 20
assign downhillcutoff = 1.5
assign uphillcost = 58
assign uphillcutoff = 1.5

assign   processUnusedTags 1  # 1 is old Brouter behaviour, 0 is new Brouter default, more efficient, but ignores tags not used by a profile. We need all tags for warnings.

---context:way   # following code refers to way-tags

assign turncost = 0
assign initialcost = 
  if highway=path|footway then 50.0 else 0.0

assign costfactorByPisteType =
  if piste:type=nordic then 1.0 
  else if route_ski_=yes then 1.0
  else if route_ski_lwn=yes then 1.0 # these are projected from relations
  else if route_ski_rwn=yes then 1.0
  else if route_ski_lcn=yes then 1.0
  else if route_ski_rcn=yes then 1.0
  else if piste:type=skitour then 3.0 
  else 10000.0

assign costfactorByPisteDifficulty = 
  if piste:difficulty=novice then 1.2
  else if piste:difficulty=easy then 1.1
  else if piste:difficulty=intermediate then 1.0
  else if piste:difficulty=advanced then 1.15
  else if piste:difficulty=expert then 1.3
  else if piste:difficulty=freeride then 100.0 # this should not be relevant to nordic at all
  else if piste:difficulty=extreme then 200.0 # this should not be relevant to nordic at all
  else 1.0

assign costfactorByPisteGrooming = 
  if piste:grooming=skating then 1.0
  else if piste:grooming=skating+classic then 1.0
  else if piste:grooming=classic+skating then 1.0
  else if piste:grooming=classic then 1.0
  else if piste:grooming=scooter then 1.2
  else if piste:grooming=backcountry then 1.35
  else 1.0

assign badOnewayPenalty =
  if reversedirection=yes then
    if piste:oneway=yes then 1000.0
    else 1.0
  else 1.0

assign costfactor = 
  multiply costfactorByPisteType 
  multiply costfactorByPisteDifficulty 
  multiply costfactorByPisteGrooming badOnewayPenalty

---context:node  # following code refers to node tags

assign defaultaccess = 
  if access=private|no then false
  else true 

assign initialcost =
  if defaultaccess then 0 else 100000
