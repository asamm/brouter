
---context:global   # following code refers to global config

assign validForBikes = false
assign validForFoot = true
assign validForCars = false

assign   turnInstructionMode = 2 # locus-style

# the elevation parameters

assign downhillcost = 20
assign downhillcutoff = 1.5
assign uphillcost = 80
assign uphillcutoff = 1.5

---context:way   # following code refers to way-tags

assign turncost = 0
assign initialcost = 0

assign costfactor =
  if piste:type=nordic then 1.0 
  else 1000

---context:node  # following code refers to node tags

assign defaultaccess = true

assign initialcost = 0 

